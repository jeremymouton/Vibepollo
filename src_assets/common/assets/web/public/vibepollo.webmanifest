{
  "id": "/v2/stream",
  "name": "Vibepollo Browser Stream",
  "short_name": "Vibepollo",
  "description": "Low-latency remote streaming from Vibepollo",
  "start_url": "/v2/stream",
  "scope": "/v2/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "background_color": "#060A18",
  "theme_color": "#060A18",
  "orientation": "any",
  "icons": [
    { "src": "/v2/images/firefly-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/v2/images/firefly-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/v2/images/firefly-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/v2/images/firefly.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
