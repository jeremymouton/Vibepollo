+} lwrtc_ice_server_t;
+
 typedef struct lwrtc_config {
   int offer_to_receive_audio;
   int offer_to_receive_video;
   // Optional bandwidth cap for the video m-section, in kbps. A zero value
   // preserves the remote offer's negotiated value.
   uint32_t local_video_bandwidth_kbps;
+  // Optional ICE servers for this peer's own candidate gathering. Without a STUN
+  // server a host behind NAT offers only host candidates, so every off-LAN
+  // client must relay. At most 8 are used; null entries are skipped.
+  const lwrtc_ice_server_t* ice_servers;
+  size_t ice_server_count;
 } lwrtc_config_t;
 
