--- a/src/libwebrtc_c.cc
+++ b/src/libwebrtc_c.cc
@@ -497,6 +497,17 @@ lwrtc_peer_t* lwrtc_factory_create_peer(
     rtc_config.offer_to_receive_audio = config->offer_to_receive_audio != 0;
     rtc_config.offer_to_receive_video = config->offer_to_receive_video != 0;
     rtc_config.local_video_bandwidth = config->local_video_bandwidth_kbps;
+    int used = 0;
+    for (size_t i = 0; config->ice_servers && i < config->ice_server_count && used < libwebrtc::kMaxIceServerSize; ++i) {
+      const auto& server = config->ice_servers[i];
+      if (!server.uri || !*server.uri) {
+        continue;
+      }
+      rtc_config.ice_servers[used].uri = libwebrtc::string(server.uri);
+      rtc_config.ice_servers[used].username = libwebrtc::string(server.username ? server.username : "");
+      rtc_config.ice_servers[used].password = libwebrtc::string(server.password ? server.password : "");
+      ++used;
+    }
   }
 
